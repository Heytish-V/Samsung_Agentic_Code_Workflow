  "cards": [
    {
      "dot": "cyan",
      "title": "Offline Indexing (NIVED + MITHUN)",
      "items": [
        "parser/ast_parser.py: TreeSitterParser.parse() → extract imports, calls, params, docstrings",
        "parser/chunker.py: SemanticChunker.chunk_file() → CodeChunk[] along function/class boundaries",
        "indexing/code_dna.py: build_code_dna() → CodeDNA{symbol, calls, imports, params, signature}",
        "graph/call_graph.py: build_call_graph() → NetworkX DiGraph resolved with import disambiguation",
        "retrieval/dense_search.py: DenseRetriever.build_index() → FAISS (BGE-small-en-v1.5)",
        "retrieval/sparse_search.py: SparseRetriever.build_index() → BM25 (rank-bm25)"
      ]
    },
    {
      "dot": "emerald",
      "title": "Online Query Pipeline (MITHUN + HEYTISH)",
      "items": [
        "retrieval/engine.py: retrieve() → dual search → reciprocal_rank_fusion(k=60) → RetrievalCandidate[]",
        "retrieval/reranker.py: ExplainableReranker.score_candidate() → {semantic, bm25, symbol, graph, final}",
        "agent/controller.py: AgenticController.run() → SEARCH/READ/EXPAND/RERANK (bounded ≤4 steps)",
        "agent/tools.py: AgentTools wraps retrieval + graph + DNA for 4 tool calls"
      ]
    },
    {
      "dot": "rose",
      "title": "Key Data Structures & Outputs",
      "items": [
        "CodeChunk: chunk_id, file_path, symbol_name, node_type, start/end_line, code, docstring, code_dna",
        "CodeDNA: symbol, file, start/end_line, functions_called[], imports[], parameters[], signature",
        "RetrievalCandidate: chunk_id, rrf_score",
        "RerankedCandidate: chunk_id, final_score, score_breakdown{semantic, bm25, symbol, graph}, why_matched",
        "SearchResponse: query, results[top-5], agent_trace[], latency_ms, total_iterations"
      ]
    }
  ]
